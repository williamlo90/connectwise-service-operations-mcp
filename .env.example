# Run python scripts/setup_local.py to generate .env with unique local passwords.
POSTGRES_PASSWORD=replace-with-random-local-password
DEMO_PASSWORD=replace-with-random-demo-password
API_PORT=8030

SIMULATOR_SECRET=replace-with-generated-local-secret

# OpenAI key for hosted mode; Anthropic/xAI optional. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
XAI_MODEL=grok-4-fast-non-reasoning
AI_DEFAULT_PROVIDER=ollama
AI_HOSTED_ENABLED=false
OLLAMA_MODEL=qwen3:0.6b
